# Copy this file to .env and fill in real values. Never commit .env.

# --- Claude (the only LLM provider) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Tavily web research ---
TAVILY_API_KEY=

# --- LangSmith tracing (set LANGSMITH_TRACING=false to disable) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ai-decision-arena
# Only needed for an EU LangSmith account: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- PostgreSQL (used from Phase 7) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_decision_arena

# --- App URLs (used from Phase 8) ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- Optional overrides (defaults live in src/ai_decision_arena/config.py) ---
# LLM_MAX_TOKENS=4000
# LLM_TIMEOUT_SECONDS=90
# LLM_MAX_RETRIES=2
# MAX_CLARIFICATION_ROUNDS=2
# MAX_RESEARCH_RETRIES=2
# MAX_DEBATE_ROUNDS=2
# MAX_SEARCH_QUERIES=6
# MAX_RESULTS_PER_QUERY=5
# MAX_EVIDENCE_ITEMS=20
# RUBRIC_WEIGHTS={"requirements_fit":0.30,"technical_feasibility":0.25,"reliability_and_risks":0.20,"cost_efficiency":0.15,"evidence_quality":0.10}
